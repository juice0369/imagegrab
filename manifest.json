{
  "manifest_version": 3,
  "name": "图提取 ImageGrab",
  "version": "1.0.0",
  "description": "一键提取电商商品详情页的图片，统一转换为 PNG 并批量下载。纯原生 JS，零依赖，零构建。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "图提取 ImageGrab（打开最近一次提取结果）",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.jd.com/*",
    "https://*.yangkeduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.alicdn.com/*",
    "https://*.taobaocdn.com/*",
    "https://*.tbcdn.cn/*",
    "https://*.360buyimg.com/*",
    "https://*.pddpic.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.jd.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/content/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/content/panel.css",
        "src/shared/*.js"
      ],
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.jd.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
